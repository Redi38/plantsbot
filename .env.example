# Telegram
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# SQLite (файл создастся сам при первом запуске)
DATABASE_URL=sqlite+aiosqlite:///./plants.db

# ИИ-агент (опционально). Совместимо с любым OpenAI-совместимым API
# (OpenAI, DeepSeek, OpenRouter и т.д.) — просто поменяй base_url и модель.
AI_ENABLED=true
AI_API_KEY=sk-...
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Веб-админка (форма логина — обязательно смени пароль)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Необязательно: ключ для подписи cookie-сессии. Если не задать — сгенерируется
# заново при каждом рестарте контейнера, тогда все залогиненные разлогинятся.
# Задать один раз и не менять, если не хочешь разлогиниваться при каждом деплое:
# python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
